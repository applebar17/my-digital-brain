APP_ENV=local
LOG_LEVEL=INFO
LOG_DIR=/app/data/logs
APP_LOG_LEVEL=INFO
AGENTIC_LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=my-digital-brain-local
LANGSMITH_ENDPOINT=

MIGRATE_ON_START=true
MIGRATE_RELATIONAL_ON_START=true
MIGRATE_GRAPH_ON_START=true
MIGRATION_RETRIES=30
MIGRATION_RETRY_SECONDS=2

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
NEO4J_DATABASE=neo4j

RELATIONAL_BACKEND=postgres
POSTGRES_DSN=postgresql+psycopg://brain:brain@postgres:5432/brain
SQLITE_PATH=data/local/brain.sqlite3

CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_PREFIX=my_digital_brain
ANONYMIZED_TELEMETRY=False

SOURCE_MEDIA_ROOT=data/source-media

FRONTEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_CHAT_AUTH_TOKEN=change-me-web-chat-token
CHAT_RUNTIME_MODE=agentic
CHAT_DEBUG_COMMANDS_ENABLED=false
INGESTION_EXECUTE_WRITE_PLAN=true
# Set true to record AI flow traces and enable /debug/ai-traces endpoints.
AI_FLOW_DEBUG_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

LLM_PROVIDER=openai
# Azure can be enabled with either LLM_PROVIDER=azure or LLM_PROVIDER=azure_openai.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL_DEFAULT=gpt-4o-mini
OPENAI_CHAT_MODEL_SMART=gpt-4.1
OPENAI_CHAT_MODEL_REASONING=o4-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBED_DEPLOYMENT=
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=
AZURE_CHAT_MODEL_DEFAULT=
AZURE_CHAT_MODEL_SMART=
AZURE_CHAT_MODEL_REASONING=
