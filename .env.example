APP_ENV=local
LOG_LEVEL=INFO

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
NEO4J_DATABASE=neo4j

RELATIONAL_BACKEND=postgres
POSTGRES_DSN=postgresql+psycopg://brain:brain@postgres:5432/brain
SQLITE_PATH=data/local/brain.sqlite3

CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_PREFIX=my_digital_brain

SOURCE_MEDIA_ROOT=data/source-media
